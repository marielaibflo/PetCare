APP_NAME=PetCare
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/La_Paz
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------- Base de datos en Supabase (PostgreSQL en la nube) ----------
# Para usarla, cambia la sección de base de datos por (datos de Supabase → Connect → Session pooler):
# DB_CONNECTION=pgsql
# DB_HOST=aws-0-xx-xxxx.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.xxxxxxxxxxxxxxxx
# DB_PASSWORD=la_contraseña_de_la_base
# DB_SSLMODE=require
# Base real (sin datos de demostración): php artisan migrate --seed --seeder=ProduccionSeeder
PETCARE_ADMIN_EMAIL=
PETCARE_ADMIN_PASSWORD=

# ---------- Iniciar sesión con Google (opcional) ----------
# Se crean en console.cloud.google.com → APIs y servicios → Credenciales → ID de cliente de OAuth (Aplicación web)
# URI de redireccionamiento autorizado: <dirección del sistema>/auth/google/callback
# Si se dejan vacíos, el botón «Continuar con Google» no aparece.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---------- PetCare · verificación y avisos ----------
# Modo demostración: muestra los códigos de verificación en pantalla (poner false en producción)
PETCARE_DEMO=true
# Comprobar que el dominio del correo exista (se omite solo si no hay internet)
PETCARE_VALIDAR_DNS=true
# WhatsApp de PetCare donde los dueños concluyen el pago de planes y suscripciones
PETCARE_WHATSAPP=59178539749
# WhatsApp al que se mandan las citas de TODAS las clínicas (muestra). Vacío = el WhatsApp de cada clínica
# Solo se usa para clínicas que todavía no registraron su WhatsApp
PETCARE_WHATSAPP_VETERINARIAS=59168186482
# WhatsApp: demo (mensajes en storage/logs/laravel.log) o meta (API de WhatsApp Business)
WHATSAPP_DRIVER=demo
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_CODIGO=
WHATSAPP_TEMPLATE_IDIOMA=es
